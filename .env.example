# ============================================================
# PetCompare — Variáveis de Ambiente (TEMPLATE)
# Copie este arquivo para .env e preencha os valores
# ============================================================

# --- Aplicação ---
APP_NAME="PetCompare"
APP_VERSION="1.0.0"
APP_ENV="development"   # development | production
DEBUG=True
SECRET_KEY="sua-chave-secreta-aqui-troque-por-algo-seguro"

# --- API ---
API_HOST="0.0.0.0"
API_PORT=8001
API_PREFIX="/api/v1"
ALLOWED_ORIGINS="http://localhost:3000,https://api.sandlj.com.br,https://pets.sandlj.com.br"

# --- Banco de Dados PostgreSQL ---
DB_HOST="seu-servidor.com"
DB_PORT=5432
DB_USER="postgres"
DB_PASSWORD="sua-senha-aqui"
DB_NAME="PetCompare"
DATABASE_URL="postgresql+asyncpg://${DB_USER}:${DB_PASSWORD}@${DB_HOST}:${DB_PORT}/${DB_NAME}"

# --- Admin ---
ADMIN_EMAIL="admin@sandlj.com.br"
ADMIN_PASSWORD="admin123"

# --- Scraping ---
SELENIUM_HEADLESS=True
SCRAPING_DELAY_MIN=2
SCRAPING_DELAY_MAX=5
MAX_RETRIES=3
USER_AGENT="Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36"

# --- Google Maps API (opcional - melhora a coleta de dados) ---
GOOGLE_MAPS_API_KEY=""

# --- Agendador ---
SCHEDULER_TIMEZONE="America/Sao_Paulo"
SCRAPING_INTERVAL_HOURS=6

# --- Logs ---
LOG_LEVEL="INFO"
LOG_FILE="logs/PetCompare.log"
